// Topic 2: Ownership — "Asset manager"
[
    (
        id: "ownership_01_asset_move",
        topic: "ownership",
        kind: FixCompile,
        difficulty: 2,
        title: "The Vanishing Texture",
        story: "Your asset manager loads textures by name. After you added a size report, the whole engine stopped compiling: the compiler claims your texture was \"moved\" and can no longer be used.",
        task: "Fix the compile error. `register_asset` must return the byte length of the texture name AND the texture string itself. Try not to clone the string.",
        signatures: ["pub fn register_asset(name: &str) -> (usize, String)"],
        starter_code: r##"pub fn load_texture(name: &str) -> String {
    format!("texture:{name}")
}

pub fn describe_asset(asset: String) -> usize {
    asset.len()
}

pub fn register_asset(name: &str) -> (usize, String) {
    let asset = load_texture(name);
    let size = describe_asset(asset);
    (size, asset)
}
"##,
        hidden_tests: r##"
#[test]
fn registers_with_size_and_asset() {
    assert_eq!(register_asset("hero"), (12, String::from("texture:hero")));
}

#[test]
fn works_for_empty_names() {
    assert_eq!(register_asset(""), (8, String::from("texture:")));
}
"##,
        checks: [
            ForbidText(text: ".clone()", message: "Borrowing is cheaper than cloning here: let `describe_asset` take a reference."),
        ],
        hints: [
            "Passing a `String` to a function by value MOVES it: the function becomes the owner and the caller can no longer use it.",
            "If a function only needs to look at a value, it can borrow it. Change `describe_asset` to take a reference and pass `&asset`.",
            "pub fn describe_asset(asset: &str) -> usize {\n    asset.len()\n}\n// ...and in register_asset: describe_asset(&asset)",
        ],
        solution: r##"pub fn load_texture(name: &str) -> String {
    format!("texture:{name}")
}

pub fn describe_asset(asset: &str) -> usize {
    asset.len()
}

pub fn register_asset(name: &str) -> (usize, String) {
    let asset = load_texture(name);
    let size = describe_asset(&asset);
    (size, asset)
}
"##,
        explanation: "Every value in Rust has exactly one owner. Passing a `String` by value moves ownership into the callee, so later uses of the original variable are rejected (E0382, use of moved value). When a function only needs to read data, take a reference (`&str`, `&String`) instead — the caller keeps ownership and nothing is copied.",
        book_links: [
            (title: "The Rust Book: What Is Ownership?", url: "https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html"),
            (title: "Rust by Example: Ownership and moves", url: "https://doc.rust-lang.org/rust-by-example/scope/move.html"),
        ],
        prerequisites: [],
        engine_tags: ["assets"],
    ),
    (
        id: "ownership_02_copy_or_move_review",
        topic: "ownership",
        kind: CodeReview,
        difficulty: 2,
        title: "Review: Who Still Owns It?",
        story: "A junior developer submitted four small functions for the asset manager. CI is red, and the failure is in exactly one of them. You are the reviewer.",
        task: "Which snippet does NOT compile?",
        explanation: "`String` owns heap memory and is not `Copy`, so `let b = a;` moves it and `a` can no longer be printed. Integers and tuples of Copy types are `Copy`: assignment copies them. `Vec::clone` makes an explicit deep copy, so both vectors stay usable.",
        solution: "Snippet B: `let b = a;` moves the String, so the later use of `a` fails (E0382).",
        book_links: [
            (title: "The Rust Book: Ways Variables and Data Interact: Move", url: "https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html"),
        ],
        prerequisites: ["ownership_01_asset_move"],
        engine_tags: ["assets"],
        quiz: Some((
            question: "Which snippet does NOT compile?",
            code: "",
            options_are_code: true,
            options: [
                r##"let a = 5;
let b = a;
println!("{a} {b}");"##,
                r##"let a = String::from("sprite");
let b = a;
println!("{a} {b}");"##,
                r##"let a = vec![1, 2, 3];
let b = a.clone();
println!("{a:?} {b:?}");"##,
                r##"let a = (1, 2.5);
let b = a;
println!("{a:?} {b:?}");"##,
            ],
            correct: 1,
            verify: OnlyCorrectFailsToCompile,
        )),
    ),
    (
        id: "ownership_03_merge_loot",
        topic: "ownership",
        kind: FromScratch,
        difficulty: 2,
        title: "Merge the Loot Tables",
        story: "Two dungeon rooms each produce a list of loot. The treasure room should hand the player ONE combined list — and since the old lists are never used again, nothing needs to be copied.",
        task: "Write `merge_loot`. It takes ownership of both lists and returns a single list with all of `first`'s items followed by all of `second`'s. Do not clone anything.",
        signatures: ["pub fn merge_loot(first: Vec<String>, second: Vec<String>) -> Vec<String>"],
        starter_code: r##"// Write `merge_loot` here.
"##,
        hidden_tests: r##"
fn v(items: &[&str]) -> Vec<String> {
    items.iter().map(|s| s.to_string()).collect()
}

#[test]
fn concatenates_in_order() {
    assert_eq!(merge_loot(v(&["sword", "shield"]), v(&["potion"])), v(&["sword", "shield", "potion"]));
}

#[test]
fn handles_empty_lists() {
    assert_eq!(merge_loot(v(&[]), v(&["gem"])), v(&["gem"]));
    assert_eq!(merge_loot(v(&["gem"]), v(&[])), v(&["gem"]));
    assert!(merge_loot(v(&[]), v(&[])).is_empty());
}

#[test]
fn keeps_duplicates() {
    assert_eq!(merge_loot(v(&["gold"]), v(&["gold"])), v(&["gold", "gold"]));
}
"##,
        checks: [
            ForbidText(text: ".clone()", message: "Moving the items is enough — no `.clone()` needed."),
            ForbidText(text: ".to_vec()", message: "Moving the items is enough — no `.to_vec()` needed."),
        ],
        hints: [
            "Because the function takes its arguments by value, it owns them. A function that owns a Vec can modify it, so you can reuse one of them as the result.",
            "Declare the first parameter as `mut first: Vec<String>`, then use a Vec method that appends everything from another collection (`extend` or `append`).",
            "pub fn merge_loot(mut first: Vec<String>, second: Vec<String>) -> Vec<String> {\n    first.extend(second);\n    // return `first`\n}",
        ],
        solution: r##"pub fn merge_loot(mut first: Vec<String>, second: Vec<String>) -> Vec<String> {
    first.extend(second);
    first
}
"##,
        explanation: "Taking ownership lets a function reuse the caller's allocation instead of copying. `extend` consumes the second vector and moves each `String` into the first. No clones, no extra allocations (beyond growing `first`), and the compiler guarantees the caller can't accidentally keep using the old vectors.",
        book_links: [
            (title: "The Rust Book: Ownership and Functions", url: "https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html"),
            (title: "Rust by Example: Vectors", url: "https://doc.rust-lang.org/rust-by-example/std/vec.html"),
        ],
        prerequisites: ["ownership_02_copy_or_move_review"],
        engine_tags: ["assets"],
    ),
    (
        id: "ownership_04_clone_refactor",
        topic: "ownership",
        kind: Refactor,
        difficulty: 3,
        title: "Stop Cloning Everything",
        story: "A profiler run shows the asset manager spending most of its time copying strings. The previous developer sprinkled `.clone()` wherever the compiler complained, without asking why.",
        task: "Refactor both functions so they contain no `.clone()` at all and `shout_all` accepts a slice (`&[String]`) instead of `&Vec<String>`. Behaviour must not change.",
        signatures: [
            "pub fn longest_name(names: Vec<String>) -> String",
            "pub fn shout_all(names: &[String]) -> Vec<String>",
        ],
        starter_code: r##"pub fn longest_name(names: Vec<String>) -> String {
    let mut best = String::new();
    for name in names.clone() {
        if name.len() > best.len() {
            best = name.clone();
        }
    }
    best
}

pub fn shout_all(names: &Vec<String>) -> Vec<String> {
    let copy = names.clone();
    copy.iter().map(|n| n.to_uppercase()).collect()
}
"##,
        hidden_tests: r##"
fn names() -> Vec<String> {
    ["Ada", "Grace", "Linus", "Margaret"].iter().map(|s| s.to_string()).collect()
}

#[test]
fn finds_the_longest_name() {
    assert_eq!(longest_name(names()), "Margaret");
    assert_eq!(longest_name(Vec::new()), "");
}

#[test]
fn first_of_equally_long_names_wins() {
    let v = vec![String::from("abc"), String::from("xyz")];
    assert_eq!(longest_name(v), "abc");
}

#[test]
fn shouting_does_not_consume_the_input() {
    let v = names();
    let loud = shout_all(&v);
    assert_eq!(loud, vec!["ADA", "GRACE", "LINUS", "MARGARET"]);
    assert_eq!(v.len(), 4);
}
"##,
        checks: [
            ForbidText(text: ".clone()", message: "No `.clone()` is needed: the function already owns the Vec (move out of it) or only reads it (borrow)."),
            ForbidText(text: "&Vec<", message: "Take a slice (`&[String]`) instead of `&Vec<String>` — it accepts more callers."),
        ],
        hints: [
            "`longest_name` takes the Vec BY VALUE, so it owns every String. Iterating over the Vec itself (`for name in names`) hands each String to you — no copy needed.",
            "Assigning `best = name;` moves the String into `best`. For `shout_all`, `iter()` only borrows, so you can call `names.iter()` directly on the parameter. A parameter of type `&[String]` accepts `&Vec<String>` too (deref coercion).",
            "pub fn longest_name(names: Vec<String>) -> String {\n    let mut best = String::new();\n    for name in names {\n        // move `name` into `best` when it is longer\n    }\n    best\n}\n\npub fn shout_all(names: &[String]) -> Vec<String> {\n    names.iter().map(|n| n.to_uppercase()).collect()\n}",
        ],
        solution: r##"pub fn longest_name(names: Vec<String>) -> String {
    let mut best = String::new();
    for name in names {
        if name.len() > best.len() {
            best = name;
        }
    }
    best
}

pub fn shout_all(names: &[String]) -> Vec<String> {
    names.iter().map(|n| n.to_uppercase()).collect()
}
"##,
        explanation: "A `.clone()` is a deep copy — here every string was allocated and copied for nothing. When a function owns its argument, iterate by value and *move* what you keep. When it only reads, borrow. Accepting `&[T]` rather than `&Vec<T>` is the idiomatic way to say \"any contiguous sequence of Ts\": callers can pass `&vec`, `&array` or a sub-slice.",
        book_links: [
            (title: "The Rust Book: Ways Variables and Data Interact: Clone", url: "https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html"),
            (title: "The Rust Book: The Slice Type", url: "https://doc.rust-lang.org/book/ch04-03-slices.html"),
        ],
        prerequisites: ["ownership_03_merge_loot"],
        engine_tags: ["assets"],
    ),
    (
        id: "ownership_05_predict_drop",
        topic: "ownership",
        kind: PredictOutput,
        difficulty: 3,
        title: "When Do Assets Die?",
        story: "The asset manager logs every time a texture or sound is freed, so you can find leaks. Before you read the log, predict it.",
        task: "What does this program print? (Hint: values are dropped when their owner goes out of scope, in reverse order of declaration.)",
        explanation: "`music` lives in the inner block, so it is dropped at the closing brace — before \"end of main\". `let moved = a;` moves the texture, so `a` no longer owns anything. At the end of `main`, locals are dropped in REVERSE order of declaration: `moved` (the texture) first, then `b` (the sound).",
        solution: "inner scope\ndrop music\nend of main\ndrop texture\ndrop sound",
        book_links: [
            (title: "The Rust Book: The Drop Trait", url: "https://doc.rust-lang.org/book/ch15-03-drop.html"),
            (title: "Rust by Example: RAII", url: "https://doc.rust-lang.org/rust-by-example/scope/raii.html"),
        ],
        prerequisites: ["ownership_04_clone_refactor"],
        engine_tags: ["assets"],
        quiz: Some((
            question: "What does this program print?",
            code: r##"struct Asset(&'static str);

impl Drop for Asset {
    fn drop(&mut self) {
        println!("drop {}", self.0);
    }
}

fn main() {
    let a = Asset("texture");
    let b = Asset("sound");
    {
        let c = Asset("music");
        println!("inner scope");
    }
    let moved = a;
    println!("end of main");
}"##,
            options: [
                "inner scope\ndrop music\nend of main\ndrop texture\ndrop sound",
                "inner scope\ndrop music\nend of main\ndrop sound\ndrop texture",
                "drop music\ninner scope\nend of main\ndrop texture\ndrop sound",
                "inner scope\nend of main\ndrop music\ndrop texture\ndrop sound",
            ],
            correct: 0,
            verify: RunOutput,
        )),
    ),
]
