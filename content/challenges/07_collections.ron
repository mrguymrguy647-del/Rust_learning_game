// Topic 7: Collections — "Inventory, leaderboards, event queue"
[
    (
        id: "collections_01_inventory_counts",
        topic: "collections",
        kind: Complete,
        difficulty: 2,
        title: "What's in the Bag?",
        story: "The inventory screen receives a flat list of picked-up item names and needs to show \"3× potion, 1× sword\". It also highlights the item you carry the most of.",
        task: "Complete `count_items` (item name → how many times it appears) and `most_common` (the name with the highest count; ties go to the alphabetically first name; empty map → `None`).",
        signatures: [
            "pub fn count_items(items: &[&str]) -> HashMap<String, u32>",
            "pub fn most_common(counts: &HashMap<String, u32>) -> Option<String>",
        ],
        starter_code: r##"use std::collections::HashMap;

pub fn count_items(items: &[&str]) -> HashMap<String, u32> {
    todo!()
}

pub fn most_common(counts: &HashMap<String, u32>) -> Option<String> {
    todo!()
}
"##,
        hidden_tests: r##"
#[test]
fn counts_each_item() {
    let counts = count_items(&["potion", "sword", "potion", "potion", "shield"]);
    assert_eq!(counts.len(), 3);
    assert_eq!(counts["potion"], 3);
    assert_eq!(counts["sword"], 1);
    assert_eq!(counts["shield"], 1);
}

#[test]
fn no_items_no_counts() {
    assert!(count_items(&[]).is_empty());
    assert_eq!(most_common(&count_items(&[])), None);
}

#[test]
fn most_common_item() {
    let counts = count_items(&["a", "b", "b", "c", "b", "a"]);
    assert_eq!(most_common(&counts), Some("b".to_string()));
}

#[test]
fn ties_go_to_the_alphabetically_first_name() {
    let counts = count_items(&["zeta", "alpha", "zeta", "alpha", "mid"]);
    assert_eq!(most_common(&counts), Some("alpha".to_string()));
}
"##,
        hints: [
            "`HashMap::entry(key).or_insert(0)` gives you a mutable reference to the count, creating it with 0 the first time. Dereference it with `*` to add one.",
            "For `most_common` iterate with `counts.iter()` and use `max_by` with a comparison on the count — then break ties by comparing the names in the *reverse* direction so the smaller name wins.",
            "pub fn count_items(items: &[&str]) -> HashMap<String, u32> {\n    let mut counts = HashMap::new();\n    for item in items {\n        *counts.entry(item.to_string()).or_insert(0) += 1;\n    }\n    counts\n}",
        ],
        solution: r##"use std::collections::HashMap;

pub fn count_items(items: &[&str]) -> HashMap<String, u32> {
    let mut counts = HashMap::new();
    for item in items {
        *counts.entry(item.to_string()).or_insert(0) += 1;
    }
    counts
}

pub fn most_common(counts: &HashMap<String, u32>) -> Option<String> {
    counts
        .iter()
        .max_by(|a, b| a.1.cmp(b.1).then(b.0.cmp(a.0)))
        .map(|(name, _)| name.clone())
}
"##,
        explanation: "The `entry` API is the idiomatic way to update a `HashMap` — one lookup, no double hashing, no `if contains_key` dance. Remember that HashMap iteration order is unspecified: whenever the result must be deterministic (as with ties here), define the order yourself with an explicit comparison.",
        book_links: [
            (title: "The Rust Book: Storing Keys with Associated Values in Hash Maps", url: "https://doc.rust-lang.org/book/ch08-03-hash-maps.html"),
            (title: "Rust by Example: HashMap", url: "https://doc.rust-lang.org/rust-by-example/std/hash.html"),
        ],
        prerequisites: [],
        engine_tags: ["inventory"],
    ),
    (
        id: "collections_02_leaderboard",
        topic: "collections",
        kind: FromScratch,
        difficulty: 3,
        title: "The Hall of Fame",
        story: "The online leaderboard keeps only each player's BEST score and shows the top N. Ties are shown alphabetically so the list never jumps around between refreshes.",
        task: "Write a `Leaderboard` type. `Leaderboard::new()` creates an empty board. `add(name, score)` records a score but keeps only the player's highest. `top(n)` returns up to `n` entries as `(name, score)` sorted by score descending, then name ascending.",
        signatures: [
            "Leaderboard::new() -> Leaderboard",
            "pub fn add(&mut self, name: &str, score: u32)",
            "pub fn top(&self, n: usize) -> Vec<(String, u32)>",
        ],
        starter_code: r##"// Write `Leaderboard` here.
"##,
        hidden_tests: r##"
#[test]
fn an_empty_board_has_no_entries() {
    let board = Leaderboard::new();
    assert!(board.top(10).is_empty());
}

#[test]
fn entries_are_sorted_by_score_descending() {
    let mut board = Leaderboard::new();
    board.add("ada", 50);
    board.add("grace", 90);
    board.add("linus", 70);
    assert_eq!(
        board.top(3),
        vec![("grace".to_string(), 90), ("linus".to_string(), 70), ("ada".to_string(), 50)]
    );
}

#[test]
fn only_the_best_score_per_player_counts() {
    let mut board = Leaderboard::new();
    board.add("ada", 50);
    board.add("ada", 80);
    board.add("ada", 20);
    assert_eq!(board.top(5), vec![("ada".to_string(), 80)]);
}

#[test]
fn top_n_truncates_and_ties_are_alphabetical() {
    let mut board = Leaderboard::new();
    for (name, score) in [("zed", 10), ("amy", 10), ("bob", 10), ("cat", 99)] {
        board.add(name, score);
    }
    assert_eq!(
        board.top(3),
        vec![("cat".to_string(), 99), ("amy".to_string(), 10), ("bob".to_string(), 10)]
    );
    assert_eq!(board.top(0), vec![]);
}
"##,
        hints: [
            "A `HashMap<String, u32>` inside the struct maps each player to their best score. The `entry` API plus `max` is a neat way to keep only the highest.",
            "For `top`, collect the map into a `Vec<(String, u32)>`, then `sort_by` with a comparison that puts higher scores first and falls back to the name: `b.1.cmp(&a.1).then(a.0.cmp(&b.0))`. Finally `truncate(n)`.",
            "pub struct Leaderboard {\n    best: HashMap<String, u32>,\n}\n\nimpl Leaderboard {\n    pub fn new() -> Leaderboard { Leaderboard { best: HashMap::new() } }\n    pub fn add(&mut self, name: &str, score: u32) {\n        let entry = self.best.entry(name.to_string()).or_insert(score);\n        // keep the maximum\n    }\n    // top …\n}",
        ],
        solution: r##"use std::collections::HashMap;

pub struct Leaderboard {
    best: HashMap<String, u32>,
}

impl Leaderboard {
    pub fn new() -> Leaderboard {
        Leaderboard { best: HashMap::new() }
    }

    pub fn add(&mut self, name: &str, score: u32) {
        let entry = self.best.entry(name.to_string()).or_insert(score);
        if score > *entry {
            *entry = score;
        }
    }

    pub fn top(&self, n: usize) -> Vec<(String, u32)> {
        let mut entries: Vec<(String, u32)> = self.best.iter().map(|(k, v)| (k.clone(), *v)).collect();
        entries.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
        entries.truncate(n);
        entries
    }
}
"##,
        explanation: "A `HashMap` gives O(1) updates; sorting only happens when the top list is requested. Because hash maps iterate in arbitrary order, `sort_by` with a total order (score, then name) makes the output deterministic. `Vec::truncate` cheaply drops the entries you do not need.",
        book_links: [
            (title: "The Rust Book: Hash Maps", url: "https://doc.rust-lang.org/book/ch08-03-hash-maps.html"),
            (title: "The Rust Book: Vectors", url: "https://doc.rust-lang.org/book/ch08-01-vectors.html"),
        ],
        prerequisites: ["collections_01_inventory_counts"],
        engine_tags: ["inventory"],
    ),
