"##,
        hidden_tests: r##"
#[test]
fn events_are_first_in_first_out() {
    let mut q = EventQueue::new();
    q.push("spawn");
    q.push("open door");
    q.push("explosion");
    assert_eq!(q.len(), 3);
    assert_eq!(q.pop(), Some("spawn".to_string()));
    assert_eq!(q.pop(), Some("open door".to_string()));
    assert_eq!(q.len(), 1);
}

#[test]
fn urgent_events_jump_the_queue() {
    let mut q = EventQueue::new();
    q.push("a");
    q.push("b");
    q.push_urgent("fire!");
    assert_eq!(q.pop(), Some("fire!".to_string()));
    assert_eq!(q.pop(), Some("a".to_string()));
}

#[test]
fn an_empty_queue_pops_none() {
    let mut q = EventQueue::new();
    assert_eq!(q.pop(), None);
    assert_eq!(q.len(), 0);
}

#[test]
fn draining_returns_everything_in_order_and_empties_the_queue() {
    let mut q = EventQueue::new();
    q.push("one");
    q.push("two");
    q.push_urgent("zero");
    assert_eq!(q.drain_all(), vec!["zero", "one", "two"]);
    assert_eq!(q.len(), 0);
    assert!(q.drain_all().is_empty());
}
"##,
        hints: [
            "`VecDeque` is a double-ended queue: `push_back`/`pop_front` work on opposite ends and are both O(1).",
            "`push` → `push_back`, `push_urgent` → `push_front`, `pop` → `pop_front`. For `drain_all`, `self.events.drain(..)` yields every element in order and leaves the deque empty.",
            "    pub fn push_urgent(&mut self, event: &str) {\n        self.events.push_front(event.to_string());\n    }\n    pub fn drain_all(&mut self) -> Vec<String> {\n        self.events.drain(..).collect()\n    }",
        ],
        solution: r##"use std::collections::VecDeque;

pub struct EventQueue {
    events: VecDeque<String>,
}

impl EventQueue {
    pub fn new() -> EventQueue {
        EventQueue { events: VecDeque::new() }
    }

    pub fn push(&mut self, event: &str) {
        self.events.push_back(event.to_string());
    }

    pub fn push_urgent(&mut self, event: &str) {
        self.events.push_front(event.to_string());
    }

    pub fn pop(&mut self) -> Option<String> {
        self.events.pop_front()
    }

    pub fn len(&self) -> usize {
        self.events.len()
    }

    pub fn drain_all(&mut self) -> Vec<String> {
        self.events.drain(..).collect()
    }
}
"##,
        explanation: "A `Vec` is great at the back, but removing from the front shifts every element (O(n)). `VecDeque` is a ring buffer: both ends are O(1), which makes it the right type for queues, undo history and sliding windows. `drain(..)` removes a range and yields the removed items — here the whole queue.",
        book_links: [
            (title: "The Rust Book: Common Collections", url: "https://doc.rust-lang.org/book/ch08-00-common-collections.html"),
        ],
        prerequisites: ["collections_02_leaderboard"],
        engine_tags: ["inventory"],
    ),
    (
        id: "collections_04_dedupe_perf",
        topic: "collections",
        kind: Performance,
        difficulty: 3,
        title: "Ten Thousand Duplicate Pickups",
        story: "The multiplayer server receives item IDs from many clients and must remove duplicates while keeping the order of first appearance. The current code is fine in testing and melts the server in production with 100,000+ IDs per tick.",
        task: "Make `dedupe_ids` fast: it must finish 200,000 ids in well under half a second. Keep the order of first appearance.",
        signatures: ["pub fn dedupe_ids(ids: &[u32]) -> Vec<u32>"],
        starter_code: r##"pub fn dedupe_ids(ids: &[u32]) -> Vec<u32> {
    let mut out = Vec::new();
    for id in ids {
        if !out.contains(id) {
            out.push(*id);
        }
    }
    out
}
"##,
        hidden_tests: r##"
use std::collections::HashSet;
use std::time::Instant;

#[test]
fn keeps_first_occurrences_in_order() {
    assert_eq!(dedupe_ids(&[3, 1, 3, 2, 1, 4]), vec![3, 1, 2, 4]);
    assert_eq!(dedupe_ids(&[]), Vec::<u32>::new());
    assert_eq!(dedupe_ids(&[7, 7, 7]), vec![7]);
}

#[test]
fn large_inputs_finish_quickly() {
    // Deterministic pseudo-random ids with many duplicates.
    let mut x: u64 = 12345;
    let ids: Vec<u32> = (0..200_000)
        .map(|_| {
            x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
            ((x >> 33) % 100_000) as u32
        })
        .collect();

    let start = Instant::now();
    let result = dedupe_ids(&ids);
    let elapsed = start.elapsed();

    // Reference answer computed the fast way.
    let mut seen = HashSet::new();
    let expected: Vec<u32> = ids.iter().copied().filter(|id| seen.insert(*id)).collect();
    assert_eq!(result, expected);
    assert!(elapsed.as_millis() < 300, "took {} ms, expected well under 300 ms", elapsed.as_millis());
}
"##,
        hints: [
            "`Vec::contains` scans the whole vector, so checking every id costs O(n²) overall. You need a data structure with fast membership tests.",
            "A `HashSet` answers \"have I seen this?\" in O(1) on average. `HashSet::insert` returns `true` only when the value was NEW — perfect as a filter.",
            "use std::collections::HashSet;\n\npub fn dedupe_ids(ids: &[u32]) -> Vec<u32> {\n    let mut seen = HashSet::new();\n    ids.iter().copied().filter(|id| seen.insert(*id)).collect()\n}",
        ],
        solution: r##"use std::collections::HashSet;

pub fn dedupe_ids(ids: &[u32]) -> Vec<u32> {
    let mut seen = HashSet::new();
    ids.iter().copied().filter(|id| seen.insert(*id)).collect()
}
"##,
        explanation: "Complexity matters more than micro-optimisations. `Vec::contains` is O(n), so deduplicating with it is O(n²): 200,000 ids means billions of comparisons. A `HashSet` makes each membership test O(1) on average, turning the whole job into O(n). `insert` returning a `bool` lets the check and the bookkeeping happen in one call.",
        book_links: [
            (title: "Rust by Example: HashSet", url: "https://doc.rust-lang.org/rust-by-example/std/hash/hashset.html"),
            (title: "The Rust Book: Hash Maps", url: "https://doc.rust-lang.org/book/ch08-03-hash-maps.html"),
        ],
        prerequisites: ["collections_03_event_queue"],
        engine_tags: ["inventory"],
        test_timeout_secs: Some(30),
    ),
    (
        id: "collections_05_review_counting",
        topic: "collections",
        kind: CodeReview,
        difficulty: 2,
        title: "Review: Counting Words",
        story: "Four implementations of \"increment the counter for this word\" were submitted for the chat filter. One of them was never compiled before being pushed.",
        task: "Which snippet does NOT compile?",
        explanation: "`HashMap::get` returns an `Option<&V>` — a shared reference you cannot add to. To change a value you need `get_mut`, or the `entry` API, which gives a `&mut V` directly. `entry(w).or_insert(0)` is the idiomatic choice: one lookup, and the missing-key case handled for you.",
        solution: "Option B: `map.get(w)` returns an `Option<&u32>`, which cannot be incremented with `+= 1`.",
        book_links: [
            (title: "The Rust Book: Updating a Hash Map", url: "https://doc.rust-lang.org/book/ch08-03-hash-maps.html"),
        ],
        prerequisites: ["collections_04_dedupe_perf"],
        engine_tags: ["inventory"],
        quiz: Some((
            question: "Which snippet does NOT compile?",
            code: "",
            options_are_code: true,
            options: [
                "*map.entry(w).or_insert(0) += 1;",
                "map.get(w) += 1;",
                "let c = map.entry(w).or_insert(0);\n*c += 1;",
                "if let Some(c) = map.get_mut(w) {\n    *c += 1;\n} else {\n    map.insert(w, 1);\n}",
            ],
            correct: 1,
            verify: OnlyCorrectFailsToCompile,
            wrapper: "use std::collections::HashMap;\nfn main() {\n    let mut map: HashMap<&str, u32> = HashMap::new();\n    for w in [\"a\", \"b\", \"a\"] {\n{CODE}\n    }\n}\n",
        )),
    ),
]
