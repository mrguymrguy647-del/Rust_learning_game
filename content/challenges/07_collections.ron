        id: "collections_03_event_queue",
        topic: "collections",
        kind: Complete,
        difficulty: 3,
        title: "The Event Queue",
        story: "Game events (\"door opened\", \"enemy spawned\") are processed in the order they arrive — except urgent ones, which jump the queue. Popping from the front of a `Vec` is slow; this is the job for a `VecDeque`.",
        task: "Complete `EventQueue`: `push` adds to the back, `push_urgent` adds to the front, `pop` removes from the front, `len` counts events and `drain_all` empties the queue returning everything in processing order.",
        signatures: [
            "pub fn new() -> EventQueue",
            "pub fn push(&mut self, event: &str)",
            "pub fn push_urgent(&mut self, event: &str)",
            "pub fn pop(&mut self) -> Option<String>",
            "pub fn len(&self) -> usize",
            "pub fn drain_all(&mut self) -> Vec<String>",
        ],
        starter_code: r##"use std::collections::VecDeque;

pub struct EventQueue {
    events: VecDeque<String>,
}

impl EventQueue {
    pub fn new() -> EventQueue {
        todo!()
    }

    pub fn push(&mut self, event: &str) {
        todo!()
    }

    pub fn push_urgent(&mut self, event: &str) {
        todo!()
    }

    pub fn pop(&mut self) -> Option<String> {
        todo!()
    }

    pub fn len(&self) -> usize {
        todo!()
    }

    pub fn drain_all(&mut self) -> Vec<String> {
