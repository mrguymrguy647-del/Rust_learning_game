// Topic 17: Operators & Conversions — "Math library: Vec2, Vec3, Matrix"
[
    (
        id: "advanced_traits_01_vec2_operators",
        topic: "advanced_traits",
        kind: Complete,
        difficulty: 3,
        title: "Vec2 Learns Arithmetic",
        story: "Writing `a.add(b)` all over the physics code is painful. The math library should let programmers write `a + b`, `a - b`, `v * 2.0` and `-v`, just like built-in numbers.",
        task: "Implement the operator traits `Add`, `Sub`, `Mul<f32>` (scale by a number) and `Neg` for `Vec2`.",
        signatures: [
            "impl Add for Vec2",
            "impl Sub for Vec2",
            "impl Mul<f32> for Vec2",
            "impl Neg for Vec2",
        ],
        starter_code: r##"use std::ops::{Add, Mul, Neg, Sub};

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Vec2 {
    pub x: f32,
    pub y: f32,
