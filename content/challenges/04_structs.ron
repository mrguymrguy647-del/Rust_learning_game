// Topic 4: Structs & Methods — "Entities: Player, Enemy, Item"
[
    (
        id: "structs_01_player_struct",
        topic: "structs",
        kind: Complete,
        difficulty: 1,
        title: "Meet the Player",
        story: "Until now the player was three loose variables. The new entity system wants a real `Player` type with behaviour attached to it.",
        task: "Implement the three methods. `new` creates a player with 100 health and 0 score. `take_damage` lowers health but never below zero. `is_alive` is true while health is above zero.",
        signatures: [
            "pub fn new(name: &str) -> Player",
            "pub fn take_damage(&mut self, amount: i32)",
            "pub fn is_alive(&self) -> bool",
        ],
        starter_code: r##"pub struct Player {
    pub name: String,
    pub health: i32,
    pub score: u32,
}

impl Player {
    pub fn new(name: &str) -> Player {
        todo!()
    }

    pub fn take_damage(&mut self, amount: i32) {
        todo!()
    }

    pub fn is_alive(&self) -> bool {
        todo!()
    }
}
"##,
        hidden_tests: r##"
#[test]
fn new_players_start_healthy() {
    let p = Player::new("Ferris");
    assert_eq!(p.name, "Ferris");
    assert_eq!(p.health, 100);
    assert_eq!(p.score, 0);
    assert!(p.is_alive());
}

#[test]
fn damage_reduces_health() {
    let mut p = Player::new("Ferris");
    p.take_damage(30);
    assert_eq!(p.health, 70);
    p.take_damage(30);
    assert_eq!(p.health, 40);
}

#[test]
fn health_never_goes_below_zero() {
    let mut p = Player::new("Ferris");
    p.take_damage(250);
    assert_eq!(p.health, 0);
    assert!(!p.is_alive());
}
"##,
        hints: [
            "A struct literal looks like `Player { name: …, health: …, score: … }`. `name` is a `&str` parameter but the field is a `String`, so you need to convert it.",
            "`self.health -= amount` changes the field through `&mut self`. To stop at zero, compare or use `max(0)` on the result. `is_alive` can simply return a comparison.",
            "pub fn new(name: &str) -> Player {\n    Player { name: name.to_string(), health: 100, score: 0 }\n}\n\npub fn take_damage(&mut self, amount: i32) {\n    self.health = (self.health - amount).max(0);\n}",
        ],
        solution: r##"pub struct Player {
    pub name: String,
    pub health: i32,
    pub score: u32,
}

impl Player {
    pub fn new(name: &str) -> Player {
        Player { name: name.to_string(), health: 100, score: 0 }
    }

    pub fn take_damage(&mut self, amount: i32) {
        self.health = (self.health - amount).max(0);
    }

    pub fn is_alive(&self) -> bool {
        self.health > 0
    }
}
"##,
        explanation: "A `struct` groups related data; an `impl` block attaches functions to it. `new` is an *associated function* (no `self`) — Rust has no constructors, by convention it is called `new`. Methods take `&self` to read and `&mut self` to modify the value they are called on. The `self` parameter is just sugar for the receiver's type.",
        book_links: [
            (title: "The Rust Book: Defining Structs", url: "https://doc.rust-lang.org/book/ch05-01-defining-structs.html"),
            (title: "The Rust Book: Method Syntax", url: "https://doc.rust-lang.org/book/ch05-03-method-syntax.html"),
        ],
        prerequisites: [],
        engine_tags: ["entities"],
    ),
