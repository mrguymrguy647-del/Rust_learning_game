    (id: "solve_80", name: "Certified Crab", description: "Solve 80 different challenges.",
     stat: "challenges_solved", at_least: 80, xp: 500),
    (id: "first_try_5", name: "Green on the First Run", description: "Solve 5 challenges on the first try, without hints.",
