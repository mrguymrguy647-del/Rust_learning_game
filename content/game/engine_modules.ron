// The engine tree. A module needs: modules it builds on, N solved challenges from given topics,
// research points (earned by solving challenges and by your programmers) and money.
// `features` unlock genres, project sizes and platforms (see genres.ron, balance.ron, platforms.ron).
[
    (id: "core_loop", name: "Game Loop & Score", topic: "basics",
     description: "A fixed-timestep loop, a score counter and a place to hang everything else.",
     requires_modules: [], required_topic_solves: [], research_cost: 0, money_cost: 0, build_weeks: 0,
     features: ["core"], bonus: (), starts_built: true),
    (id: "asset_manager", name: "Asset Manager", topic: "ownership",
     description: "Loads textures and sounds once and hands out references. Ownership, finally explained.",
     requires_modules: ["core_loop"], required_topic_solves: [("ownership", 3)],
     research_cost: 30, money_cost: 1000, build_weeks: 2,
     features: ["assets"], bonus: (graphics: 0.05, audio: 0.05)),
    (id: "dialogue", name: "Text & Dialogue", topic: "borrowing",
     description: "Renders text boxes and branching dialogue without copying a single string.",
     requires_modules: ["core_loop"], required_topic_solves: [("borrowing", 3)],
     research_cost: 40, money_cost: 1500, build_weeks: 3,
     features: ["dialogue"], bonus: (story: 0.12)),
    (id: "renderer_2d", name: "2D Renderer & Entities", topic: "structs",
     description: "Sprites, layers and the Player/Enemy/Item entities that live on them.",
     requires_modules: ["asset_manager"], required_topic_solves: [("structs", 3)],
     research_cost: 60, money_cost: 3000, build_weeks: 4,
     features: ["renderer_2d", "entities"], bonus: (graphics: 0.15, gameplay: 0.03)),
    (id: "input_states", name: "Input & Game States", topic: "enums",
     description: "Menus, pause, game over: a state machine fed by keyboard and gamepad.",
     requires_modules: ["core_loop"], required_topic_solves: [("enums", 3)],
     research_cost: 50, money_cost: 2000, build_weeks: 3,
     features: ["input"], bonus: (gameplay: 0.10)),
    (id: "save_system", name: "Save & Load System", topic: "errors",
     description: "Persists progress and survives corrupt files with proper error handling.",
     requires_modules: ["core_loop"], required_topic_solves: [("errors", 3)],
     research_cost: 60, money_cost: 2500, build_weeks: 3,
     features: ["save"], bonus: (performance: 0.05)),
    (id: "inventory", name: "Inventory & Event Queue", topic: "collections",
     description: "Item stacks, leaderboards and a queue of game events.",
     requires_modules: ["renderer_2d"], required_topic_solves: [("collections", 3)],
     research_cost: 70, money_cost: 3500, build_weeks: 4,
     features: ["inventory"], bonus: (gameplay: 0.08)),
    (id: "modular_engine", name: "Modular Engine", topic: "modules",
     description: "Splits the engine into crates and modules with clean public interfaces.",
     requires_modules: ["renderer_2d"], required_topic_solves: [("modules", 2)],
     research_cost: 90, money_cost: 6000, build_weeks: 5,
     features: ["modular"], bonus: (performance: 0.08)),
    (id: "components", name: "Component System", topic: "traits",
     description: "Traits and trait objects turn game objects into mix-and-match components.",
     requires_modules: ["modular_engine"], required_topic_solves: [("traits", 3)],
     research_cost: 110, money_cost: 10000, build_weeks: 6,
     features: ["components"], bonus: (gameplay: 0.10, graphics: 0.05)),
    (id: "level_loader", name: "Zero-Copy Level Loader", topic: "lifetimes",
     description: "Parses level files in place, borrowing from the buffer instead of copying it.",
     requires_modules: ["modular_engine"], required_topic_solves: [("lifetimes", 3)],
     research_cost: 120, money_cost: 12000, build_weeks: 5,
     features: ["levels"], bonus: (performance: 0.06, story: 0.04)),
    (id: "ai", name: "AI & Particle Filters", topic: "iterators",
     description: "Iterator pipelines for particle systems and enemy decision making.",
     requires_modules: ["components"], required_topic_solves: [("iterators", 3)],
     research_cost: 150, money_cost: 20000, build_weeks: 6,
     features: ["ai"], bonus: (gameplay: 0.12)),
    (id: "scene_graph", name: "Scene Graph", topic: "smart_pointers",
     description: "A tree of objects with parents and children using Rc, RefCell and Weak.",
     requires_modules: ["components"], required_topic_solves: [("smart_pointers", 3)],
     research_cost: 160, money_cost: 25000, build_weeks: 6,
     features: ["scene"], bonus: (graphics: 0.10)),
    (id: "editor_tools", name: "Editor & QA Tools", topic: "testing",
     description: "A level editor, a test suite and a QA pipeline: fewer bugs, bigger games.",
     requires_modules: ["modular_engine"], required_topic_solves: [("testing", 3)],
     research_cost: 180, money_cost: 30000, build_weeks: 6,
     features: ["editor"], bonus: (performance: 0.06, gameplay: 0.03, story: 0.03), min_tier: 2),
    (id: "job_system", name: "Job System", topic: "concurrency",
     description: "Multithreaded asset loading and a work-stealing job queue.",
     requires_modules: ["scene_graph"], required_topic_solves: [("concurrency", 3)],
     research_cost: 220, money_cost: 40000, build_weeks: 8,
     features: ["jobs"], bonus: (performance: 0.15), min_tier: 2),
    (id: "audio", name: "Audio Engine", topic: "concurrency",
     description: "Streaming, mixing and effects on a dedicated audio thread.",
     requires_modules: ["asset_manager", "job_system"], required_topic_solves: [("iterators", 3), ("concurrency", 3)],
     research_cost: 100, money_cost: 8000, build_weeks: 4,
     features: ["audio"], bonus: (audio: 0.22)),
    (id: "networking", name: "Online Multiplayer", topic: "async",
     description: "Futures, wakers and a tiny executor drive the netcode.",
     requires_modules: ["job_system"], required_topic_solves: [("async", 3)],
     research_cost: 260, money_cost: 60000, build_weeks: 8,
     features: ["networking"], bonus: (gameplay: 0.08), min_tier: 2),
    (id: "scripting", name: "Scripting DSL", topic: "macros",
     description: "Declarative macros give designers a tiny language for quests and cutscenes.",
     requires_modules: ["components"], required_topic_solves: [("macros", 3)],
     research_cost: 240, money_cost: 50000, build_weeks: 8,
     features: ["scripting"], bonus: (gameplay: 0.08, story: 0.08), min_tier: 2),
    (id: "math_lib", name: "Math Library", topic: "advanced_traits",
     description: "Vec2, Vec3 and Matrix with operator overloading, Default, From and Display.",
     requires_modules: ["modular_engine"], required_topic_solves: [("advanced_traits", 3)],
     research_cost: 280, money_cost: 60000, build_weeks: 8,
     features: ["math"], bonus: (performance: 0.06, graphics: 0.05), min_tier: 2),
    (id: "physics", name: "2D Physics", topic: "advanced_traits",
     description: "Collision detection and rigid bodies on top of your math library.",
     requires_modules: ["math_lib", "components"], required_topic_solves: [("advanced_traits", 4), ("traits", 4)],
     research_cost: 200, money_cost: 35000, build_weeks: 7,
     features: ["physics"], bonus: (gameplay: 0.12, performance: 0.05), min_tier: 2),
    (id: "low_level", name: "Low-Level Optimization", topic: "unsafe",
     description: "Raw pointers and safe wrappers around the hottest loops.",
     requires_modules: ["math_lib"], required_topic_solves: [("unsafe", 3)],
     research_cost: 300, money_cost: 80000, build_weeks: 8,
     features: ["optimized"], bonus: (performance: 0.12), min_tier: 3),
    (id: "renderer_3d", name: "3D Renderer", topic: "unsafe",
     description: "Meshes, cameras and shaders. A big step towards AAA.",
     requires_modules: ["math_lib", "scene_graph", "low_level"], required_topic_solves: [("unsafe", 4)],
     research_cost: 400, money_cost: 150000, build_weeks: 12,
     features: ["renderer_3d"], bonus: (graphics: 0.30), min_tier: 3),
    (id: "aaa_optimization", name: "AAA Optimization Pass", topic: "performance",
     description: "Profiling, allocation-free hot paths and cache-friendly data layouts.",
     requires_modules: ["low_level", "job_system"], required_topic_solves: [("performance", 3)],
     research_cost: 350, money_cost: 120000, build_weeks: 10,
     features: ["aaa_ready"], bonus: (performance: 0.15, graphics: 0.05), min_tier: 3),
]
