// Friendly explanations for common rustc error codes. Shown next to the raw compiler message.
[
    (id: "E0382", title: "Use of a moved value",
     explanation: "You gave away ownership of a value (assigned it to another variable, or passed it to a function by value) and then tried to use the original again. In Rust every value has exactly one owner; after a move, the old name is empty.",
     how_to_fix: "Borrow instead of moving (pass `&value`), clone it if you really need two copies (`value.clone()`), or restructure so the last use is the move. Types that implement `Copy` (numbers, bool, char) are copied instead of moved.",
     book_url: "https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html"),
    (id: "E0499", title: "Two mutable borrows at once",
     explanation: "You asked for a second `&mut` reference to something that already has a live `&mut` reference. Rust allows only one writer at a time so two parts of your code can never change the same data simultaneously.",
     how_to_fix: "Finish using the first mutable reference before creating the second (shorten its scope), split the data into separate parts, or use methods like `split_at_mut`.",
     book_url: "https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html"),
    (id: "E0502", title: "Mutable and shared borrow conflict",
     explanation: "A reference that only reads (`&T`) is still alive while you try to modify the same value (`&mut`). While someone is reading, nobody may write — otherwise the reader could see data change (or disappear) under its feet.",
     how_to_fix: "Do the reading first and let the shared reference die (its last use) before you mutate, or copy the piece of data you need (`.clone()`, `.to_uppercase()`, …) so you hold an owned value instead of a reference.",
     book_url: "https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html"),
    (id: "E0503", title: "Use of a borrowed value",
     explanation: "A value is used while it is mutably borrowed elsewhere.",
     how_to_fix: "Make sure the mutable borrow has ended (last used) before touching the value directly.",
     book_url: "https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html"),
    (id: "E0505", title: "Moving out while borrowed",
     explanation: "You tried to move a value (give up ownership) while a reference to it is still alive. That would leave the reference pointing at something that now belongs to someone else.",
     how_to_fix: "Make sure the borrow is finished before the move, or move a clone instead.",
     book_url: "https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html"),
    (id: "E0506", title: "Assigning to a borrowed value",
     explanation: "You are overwriting a variable that something else is currently borrowing.",
     how_to_fix: "Finish with the reference first, or store the new value somewhere else.",
     book_url: "https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html"),
    (id: "E0106", title: "Missing lifetime specifier",
     explanation: "A function or struct returns or holds a reference, but the compiler cannot tell WHICH input the reference comes from — so it cannot prove the reference stays valid. Lifetime annotations such as `'a` describe that relationship.",
     how_to_fix: "Add a lifetime parameter: `fn longest<'a>(a: &'a str, b: &'a str) -> &'a str`. In structs: `struct Parser<'a> { text: &'a str }`. If the data should be owned, use `String` instead of `&str`.",
     book_url: "https://doc.rust-lang.org/book/ch10-03-lifetime-syntax.html"),
    (id: "E0261", title: "Undeclared lifetime",
     explanation: "You used a lifetime name like `'a` without declaring it. Lifetimes are generic parameters and must be declared in angle brackets first.",
     how_to_fix: "Declare it: `fn f<'a>(x: &'a str)` or `impl<'a> Parser<'a>`.",
     book_url: "https://doc.rust-lang.org/book/ch10-03-lifetime-syntax.html"),
    (id: "E0308", title: "Mismatched types",
     explanation: "The compiler expected one type but found another — for example an `i32` where a `u32` is needed, a `&str` where a `String` is needed, or `()` because of a stray semicolon on the last line of a function.",
     how_to_fix: "Read the \"expected … found …\" lines. Convert explicitly (`as`, `.into()`, `.to_string()`, `&s[..]`), change the declared type, or remove the trailing `;` if you meant that expression to be returned.",
     book_url: "https://doc.rust-lang.org/book/ch03-02-data-types.html"),
    (id: "E0384", title: "Assigning twice to an immutable variable",
     explanation: "Variables are immutable by default. You tried to change one that was declared with a plain `let`.",
     how_to_fix: "Declare it with `let mut` if it is meant to change. If you want a new value with a new meaning, shadow it with another `let`.",
     book_url: "https://doc.rust-lang.org/book/ch03-01-variables-and-mutability.html"),
    (id: "E0594", title: "Cannot assign to immutable data",
     explanation: "You tried to modify a field or element of something that is not mutable (a non-`mut` variable or a `&` reference).",
     how_to_fix: "Make the variable `mut`, or take `&mut` in the function signature.",
     book_url: "https://doc.rust-lang.org/book/ch03-01-variables-and-mutability.html"),
    (id: "E0596", title: "Cannot borrow as mutable",
     explanation: "You are trying to modify something through a reference or variable that is not declared mutable.",
     how_to_fix: "Add `mut` to the variable (`let mut v = …`) or change the parameter to `&mut T`.",
     book_url: "https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html"),
    (id: "E0597", title: "Value does not live long enough",
     explanation: "A reference outlives the thing it points to: the value is dropped at the end of its scope while the reference is still used afterwards.",
     how_to_fix: "Move the value to an outer scope so it lives longer, return an owned value instead of a reference, or clone the data.",
     book_url: "https://doc.rust-lang.org/book/ch10-03-lifetime-syntax.html"),
    (id: "E0515", title: "Returning a reference to a local variable",
     explanation: "You are returning a reference to something created inside the function. That value is destroyed when the function ends, so the reference would dangle.",
     how_to_fix: "Return the owned value (`String`, `Vec`, …) instead of a reference, or take the data in as a parameter and return a reference into that.",
     book_url: "https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html"),
    (id: "E0716", title: "Temporary value dropped while borrowed",
     explanation: "You borrowed a temporary value (like the result of a function call) and tried to keep the reference after the statement ended — by then the temporary is gone.",
     how_to_fix: "Store the value in a named variable first (`let owned = make();`), then borrow from that variable.",
     book_url: "https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html"),
    (id: "E0507", title: "Cannot move out of a borrow",
     explanation: "You are trying to take ownership of data that you only have a reference to. A borrower may look, but it must hand the data back intact.",
     how_to_fix: "Clone it, use a method that borrows (`.as_str()`, `.iter()`), or use `Option::take()` / `std::mem::take` to swap in a replacement.",
     book_url: "https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html"),
    (id: "E0373", title: "Closure may outlive the current function",
     explanation: "A closure that borrows local variables is being sent somewhere that may keep it alive longer than those variables (typically `thread::spawn`).",
     how_to_fix: "Use a `move` closure so it takes ownership of what it needs: `thread::spawn(move || { … })`. Share data between threads with `Arc`.",
     book_url: "https://doc.rust-lang.org/book/ch16-01-threads.html"),
    (id: "E0381", title: "Use of a possibly uninitialized variable",
     explanation: "You read a variable before giving it a value on every possible path.",
     how_to_fix: "Initialize it when declaring it, or make sure every `if`/`match` branch assigns it.",
     book_url: "https://doc.rust-lang.org/book/ch03-01-variables-and-mutability.html"),
    (id: "E0425", title: "Unresolved name",
     explanation: "The compiler cannot find a variable, function or constant with that name. A typo, a missing `use`, or — in these challenges — your function name/signature does not match the one the tests expect.",
     how_to_fix: "Check the spelling, make sure the item is defined (and `pub` if it lives in another module), and that function names exactly match the ones listed in the task.",
     book_url: "https://doc.rust-lang.org/book/ch07-04-bringing-paths-into-scope-with-the-use-keyword.html"),
    (id: "E0432", title: "Unresolved import",
     explanation: "A `use` statement refers to a path that does not exist.",
     how_to_fix: "Check the module path and spelling. Standard library items live under `std::`, e.g. `use std::collections::HashMap;`.",
     book_url: "https://doc.rust-lang.org/book/ch07-04-bringing-paths-into-scope-with-the-use-keyword.html"),
    (id: "E0433", title: "Failed to resolve a path",
     explanation: "A path like `HashMap::new()` could not be resolved — most often the type was never imported.",
     how_to_fix: "Add the missing `use` (for example `use std::collections::HashMap;`) or write the full path.",
     book_url: "https://doc.rust-lang.org/book/ch07-04-bringing-paths-into-scope-with-the-use-keyword.html"),
    (id: "E0423", title: "Expected a value, found a struct",
     explanation: "You used a struct name where a value is needed, for example `Point` instead of `Point { x: 1, y: 2 }` or `Point::new(1, 2)`.",
     how_to_fix: "Construct the struct with its fields or call its constructor function.",
     book_url: "https://doc.rust-lang.org/book/ch05-01-defining-structs.html"),
    (id: "E0424", title: "`self` used outside a method",
     explanation: "`self` only exists in methods whose first parameter is `self`, `&self` or `&mut self`.",
     how_to_fix: "Add `&self` (or `&mut self`) to the method signature, or make the function take the data explicitly.",
     book_url: "https://doc.rust-lang.org/book/ch05-03-method-syntax.html"),
    (id: "E0428", title: "Defined twice",
     explanation: "Two items with the same name exist in the same module.",
     how_to_fix: "Rename one of them or delete the duplicate.",
     book_url: "https://doc.rust-lang.org/book/ch07-02-defining-modules-to-control-scope-and-privacy.html"),
    (id: "E0599", title: "No method or item with that name",
     explanation: "The type has no method (or associated function) with that name — or the method exists but only when a trait is imported or a trait bound is satisfied.",
     how_to_fix: "Check the spelling and the type (`Option<T>` vs `T`). If the method comes from a trait, `use` the trait. For generics, add the needed bound such as `T: Display`.",
     book_url: "https://doc.rust-lang.org/book/ch05-03-method-syntax.html"),
    (id: "E0609", title: "No such field",
     explanation: "The struct has no field with that name.",
     how_to_fix: "Check the struct definition for the exact field names (and that you are not using a tuple-struct index on a named struct).",
     book_url: "https://doc.rust-lang.org/book/ch05-01-defining-structs.html"),
    (id: "E0616", title: "Private field",
     explanation: "You are accessing a struct field that is private to its module.",
     how_to_fix: "Make the field `pub`, or add a public method (getter) in the module that owns it.",
     book_url: "https://doc.rust-lang.org/book/ch07-03-paths-for-referring-to-an-item-in-the-module-tree.html"),
    (id: "E0603", title: "Private item",
     explanation: "The function, struct or module you are using exists but is private to the module it was declared in.",
     how_to_fix: "Mark it `pub` (and `pub` on the modules on the path) if it is meant to be used from outside.",
     book_url: "https://doc.rust-lang.org/book/ch07-02-defining-modules-to-control-scope-and-privacy.html"),
    (id: "E0061", title: "Wrong number of arguments",
     explanation: "A function or method was called with more or fewer arguments than its signature declares.",
     how_to_fix: "Compare the call with the function signature. Remember methods take `self` implicitly.",
     book_url: "https://doc.rust-lang.org/book/ch03-03-how-functions-work.html"),
    (id: "E0063", title: "Missing struct field",
     explanation: "A struct literal does not provide a value for every field.",
     how_to_fix: "Provide all fields, or fill the rest with `..Default::default()` if the struct implements `Default`.",
     book_url: "https://doc.rust-lang.org/book/ch05-01-defining-structs.html"),
    (id: "E0004", title: "Non-exhaustive match",
     explanation: "A `match` must cover every possible value. You left at least one enum variant (or value range) unhandled.",
     how_to_fix: "Add arms for the missing patterns listed by the compiler, or add a catch-all arm `_ => …` if one behaviour fits the rest.",
     book_url: "https://doc.rust-lang.org/book/ch06-02-match.html"),
    (id: "E0023", title: "Wrong number of fields in pattern",
     explanation: "An enum variant pattern names a different number of fields than the variant has.",
     how_to_fix: "Match the number of fields in the variant definition (use `_` for ones you ignore, or `..`).",
     book_url: "https://doc.rust-lang.org/book/ch06-02-match.html"),
    (id: "E0026", title: "Struct pattern names a missing field",
     explanation: "A pattern refers to a field that the struct does not have.",
     how_to_fix: "Check the struct definition for the field names.",
     book_url: "https://doc.rust-lang.org/book/ch19-03-pattern-syntax.html"),
    (id: "E0277", title: "Trait bound not satisfied",
     explanation: "A type is used somewhere that needs a capability (a trait) it does not have — for example printing with `{}` needs `Display`, `?` needs the error type to convert, a `HashMap` key needs `Hash + Eq`, and sending data to a thread needs `Send`.",
     how_to_fix: "Implement or derive the missing trait (`#[derive(Debug, Clone, PartialEq)]`), add a bound to your generic (`T: Display`), or change the type. Read the `required by a bound in …` note: it tells you what asked for the trait.",
     book_url: "https://doc.rust-lang.org/book/ch10-02-traits.html"),
    (id: "E0282", title: "Type annotations needed",
     explanation: "The compiler could not work out a type by itself, for example for `Vec::new()` that is never filled or `.collect()` without a target.",
     how_to_fix: "Annotate the variable (`let v: Vec<i32> = …`) or use the turbofish (`.collect::<Vec<_>>()`, `\"5\".parse::<i32>()`).",
     book_url: "https://doc.rust-lang.org/book/ch03-02-data-types.html"),
    (id: "E0283", title: "Type annotations needed (ambiguous)",
     explanation: "More than one type could satisfy this expression and the compiler refuses to guess.",
     how_to_fix: "Say which type you mean with an annotation or turbofish.",
     book_url: "https://doc.rust-lang.org/book/ch03-02-data-types.html"),
    (id: "E0369", title: "Operator not supported for this type",
     explanation: "You used an operator like `+`, `==` or `<` on a type that does not implement it. Operators are traits (`Add`, `PartialEq`, `PartialOrd` …).",
     how_to_fix: "Derive or implement the matching trait (`#[derive(PartialEq)]`, `impl Add for …`) or add the bound on your generic (`T: Add<Output = T>`).",
     book_url: "https://doc.rust-lang.org/book/ch20-02-advanced-traits.html"),
    (id: "E0600", title: "Cannot apply unary operator",
     explanation: "A unary operator like `!` or `-` was applied to a type that does not support it.",
     how_to_fix: "Implement `Not` / `Neg` for the type or convert it to a type that supports the operator.",
     book_url: "https://doc.rust-lang.org/book/ch20-02-advanced-traits.html"),
    (id: "E0605", title: "Invalid cast",
     explanation: "`as` only works between primitive types (numbers, `char`, `bool`, raw pointers). Structs and strings need conversion traits instead.",
     how_to_fix: "Use `From`/`Into`, `TryFrom`, `.parse()` or a method that does the conversion.",
     book_url: "https://doc.rust-lang.org/rust-by-example/conversion/from_into.html"),
    (id: "E0608", title: "Cannot index into this type",
     explanation: "The `[]` operator is not supported by this type.",
     how_to_fix: "Index slices, arrays, `Vec` and `HashMap` (by key). For custom types implement `Index`.",
     book_url: "https://doc.rust-lang.org/book/ch08-01-vectors.html"),
    (id: "E0614", title: "Cannot dereference this type",
     explanation: "`*` only works on references and smart pointers; this value is neither.",
     how_to_fix: "Remove the `*`, or check that you are really holding a reference.",
     book_url: "https://doc.rust-lang.org/book/ch15-02-deref.html"),
    (id: "E0689", title: "Method on an ambiguous numeric type",
     explanation: "A method was called on a number literal whose exact type has not been decided yet (e.g. `2.0.powi(2)`).",
     how_to_fix: "Give the number a type: `2.0_f64.powi(2)` or `let x: f64 = 2.0;`.",
     book_url: "https://doc.rust-lang.org/book/ch03-02-data-types.html"),
    (id: "E0133", title: "Unsafe operation outside unsafe",
     explanation: "Dereferencing a raw pointer, calling an `unsafe fn` or accessing a `static mut` is only allowed inside an `unsafe` block, where YOU promise the compiler's rules are upheld.",
     how_to_fix: "Wrap the minimal operation in `unsafe { … }` and document why it is sound — or avoid it by using a safe API.",
     book_url: "https://doc.rust-lang.org/book/ch20-01-unsafe-rust.html"),
    (id: "E0038", title: "Trait is not dyn compatible",
     explanation: "A trait object (`Box<dyn Trait>`) needs all methods to be callable without knowing the concrete type. Generic methods or methods returning `Self` break that.",
     how_to_fix: "Remove the generic/`Self`-returning methods from the trait, mark them `where Self: Sized`, or use generics instead of `dyn`.",
     book_url: "https://doc.rust-lang.org/book/ch18-02-trait-objects.html"),
    (id: "E0046", title: "Missing trait items",
     explanation: "An `impl Trait for Type` block must define every required method of the trait.",
     how_to_fix: "Add the missing methods listed by the compiler.",
     book_url: "https://doc.rust-lang.org/book/ch10-02-traits.html"),
    (id: "E0053", title: "Method signature differs from the trait",
     explanation: "A method in an `impl` block has different parameter or return types than the trait declares.",
     how_to_fix: "Make the signature match the trait exactly (including `&self` vs `&mut self`).",
     book_url: "https://doc.rust-lang.org/book/ch10-02-traits.html"),
    (id: "E0117", title: "Orphan rule violated",
     explanation: "You can only implement a trait for a type if either the trait or the type is defined in YOUR crate. This prevents two crates from giving conflicting implementations.",
     how_to_fix: "Wrap the foreign type in your own struct (the newtype pattern) and implement the trait for that.",
     book_url: "https://doc.rust-lang.org/book/ch20-02-advanced-traits.html"),
    (id: "E0107", title: "Wrong number of generic arguments",
     explanation: "A type or function was given too many or too few generic parameters (or lifetimes).",
     how_to_fix: "Compare with the definition: `Vec<T>` takes one type, `HashMap<K, V>` takes two.",
     book_url: "https://doc.rust-lang.org/book/ch10-01-syntax.html"),
    (id: "E0072", title: "Recursive type has infinite size",
     explanation: "A struct or enum contains itself directly, so the compiler cannot compute how much memory it needs.",
     how_to_fix: "Put the recursive part behind a pointer with a known size: `Box<Self>` (or `Rc`, `Vec`, `Option<Box<…>>`).",
     book_url: "https://doc.rust-lang.org/book/ch15-01-box.html"),
    (id: "E0728", title: "`await` outside of async",
     explanation: "`.await` can only be used inside an `async fn` or `async` block.",
     how_to_fix: "Make the surrounding function `async`, or drive the future with an executor / `block_on`.",
     book_url: "https://doc.rust-lang.org/book/ch17-01-futures-and-syntax.html"),
    (id: "E0434", title: "Functions cannot capture variables",
     explanation: "A nested `fn` cannot use local variables of the enclosing function. Only closures capture their environment.",
     how_to_fix: "Use a closure (`let f = |x| x + offset;`) or pass the value as a parameter.",
     book_url: "https://doc.rust-lang.org/book/ch13-01-closures.html"),
    (id: "E0435", title: "Non-constant value in a constant",
     explanation: "Array lengths and `const` values must be known at compile time; you used a runtime variable.",
     how_to_fix: "Use a `const` or a literal, or use a `Vec` for runtime-sized collections.",
     book_url: "https://doc.rust-lang.org/book/ch03-02-data-types.html"),
    (id: "E0658", title: "Unstable feature",
     explanation: "You used something that is only available on nightly Rust.",
     how_to_fix: "Use the stable alternative described in the note.",
     book_url: "https://doc.rust-lang.org/book/ch01-01-installation.html"),
    (id: "E0015", title: "Non-const call in a const context",
     explanation: "Only `const fn` can be called when initializing a `const` or `static`.",
     how_to_fix: "Use a const-compatible expression, or initialize at runtime (e.g. with `LazyLock`).",
     book_url: "https://doc.rust-lang.org/book/ch03-01-variables-and-mutability.html"),
]
