// The curriculum: 19 topics, each themed around an engine/game feature.
[
    (id: "basics", order: 1, name: "Basics", feature_name: "Game loop & score counter",
     summary: "Variables, mutability, shadowing, scalar types, functions and control flow.",
     book_url: "https://doc.rust-lang.org/book/ch03-00-common-programming-concepts.html"),
    (id: "ownership", order: 2, name: "Ownership", feature_name: "Asset manager",
     summary: "Move semantics, Clone and Copy: who owns each texture and sound?",
     book_url: "https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html"),
    (id: "borrowing", order: 3, name: "Borrowing & Slices", feature_name: "Text rendering & dialogue",
     summary: "References, slices, String vs &str.",
     book_url: "https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html"),
    (id: "structs", order: 4, name: "Structs & Methods", feature_name: "Entities: Player, Enemy, Item",
     summary: "Structs, impl blocks, associated functions and methods.",
     book_url: "https://doc.rust-lang.org/book/ch05-00-structs.html"),
    (id: "enums", order: 5, name: "Enums & Matching", feature_name: "Game states & input handling",
     summary: "Enums, pattern matching and Option.",
     book_url: "https://doc.rust-lang.org/book/ch06-00-enums.html"),
    (id: "errors", order: 6, name: "Error Handling", feature_name: "Save/load system & file loading",
     summary: "Result, the ? operator and custom error types.",
     book_url: "https://doc.rust-lang.org/book/ch09-00-error-handling.html"),
    (id: "collections", order: 7, name: "Collections", feature_name: "Inventory, leaderboards, event queue",
     summary: "Vec, HashMap, HashSet and VecDeque.",
     book_url: "https://doc.rust-lang.org/book/ch08-00-common-collections.html"),
    (id: "modules", order: 8, name: "Modules & Crates", feature_name: "Organizing the engine",
     summary: "Modules, visibility, paths and use.",
     book_url: "https://doc.rust-lang.org/book/ch07-00-managing-growing-projects-with-packages-crates-and-modules.html"),
    (id: "traits", order: 9, name: "Traits & Generics", feature_name: "Component system & renderers",
     summary: "Traits, trait objects, generics and trait bounds.",
     book_url: "https://doc.rust-lang.org/book/ch10-02-traits.html"),
    (id: "lifetimes", order: 10, name: "Lifetimes", feature_name: "Zero-copy parsers & level loaders",
     summary: "Lifetime annotations on functions and structs.",
     book_url: "https://doc.rust-lang.org/book/ch10-03-lifetime-syntax.html"),
    (id: "iterators", order: 11, name: "Closures & Iterators", feature_name: "Particle systems & AI filters",
     summary: "Closures, iterator adapters and consumers.",
     book_url: "https://doc.rust-lang.org/book/ch13-00-functional-features.html"),
    (id: "smart_pointers", order: 12, name: "Smart Pointers", feature_name: "Scene graph / object trees",
     summary: "Box, Rc, RefCell and Weak.",
     book_url: "https://doc.rust-lang.org/book/ch15-00-smart-pointers.html"),
    (id: "testing", order: 13, name: "Testing & Docs", feature_name: "QA department",
     summary: "Unit tests, assertions, doc comments.",
     book_url: "https://doc.rust-lang.org/book/ch11-00-testing.html"),
    (id: "concurrency", order: 14, name: "Concurrency", feature_name: "Multithreaded asset loading & job system",
     summary: "Threads, Arc, Mutex and channels.",
     book_url: "https://doc.rust-lang.org/book/ch16-00-concurrency.html"),
    (id: "async", order: 15, name: "Async Basics", feature_name: "Online multiplayer & networking",
     summary: "Futures, polling, wakers and a tiny executor.",
     book_url: "https://doc.rust-lang.org/book/ch17-00-async-await.html"),
    (id: "macros", order: 16, name: "Declarative Macros", feature_name: "Engine DSL / scripting",
     summary: "macro_rules!, repetitions and fragment specifiers.",
     book_url: "https://doc.rust-lang.org/book/ch20-05-macros.html"),
    (id: "advanced_traits", order: 17, name: "Operators & Conversions", feature_name: "Math library: Vec2, Vec3, Matrix",
     summary: "Operator overloading, Default, From/Into and Display.",
     book_url: "https://doc.rust-lang.org/book/ch20-02-advanced-traits.html"),
    (id: "unsafe", order: 18, name: "Unsafe & FFI", feature_name: "Low-level optimization",
     summary: "What unsafe really means, raw pointers and safe wrappers.",
     book_url: "https://doc.rust-lang.org/book/ch20-01-unsafe-rust.html"),
    (id: "performance", order: 19, name: "Performance", feature_name: "AAA optimization pass",
     summary: "Algorithmic complexity, allocation and profiling idioms.",
     book_url: "https://doc.rust-lang.org/book/ch13-04-performance.html"),
]
